{
  "stages": {
    "stages": [
      {
        "id": "backlog",
        "label": "Backlog"
      },
      {
        "id": "building",
        "label": "Building",
        "exit": "Change is complete locally with tests passing.",
        "auto": true,
        "requires": {
          "owner": true
        }
      },
      {
        "id": "done",
        "label": "Done",
        "role": "done",
        "exit": "Evidence recorded: commit and test path.",
        "auto": true,
        "requires": {
          "scope": true,
          "evidence_min": 1,
          "deps_at_least": "building",
          "children_done": true
        }
      }
    ],
    "terminal": [
      "done",
      "dropped"
    ],
    "extra": [
      {
        "id": "dropped",
        "label": "Dropped",
        "role": "dropped"
      },
      {
        "id": "paused",
        "label": "Paused",
        "role": "paused"
      }
    ]
  },
  "policy": {
    "triage_required_for": []
  }
}
